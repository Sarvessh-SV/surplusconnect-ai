# ==============================================================================
# SurplusConnect AI - Environment Configuration
# Copy to backend/.env and frontend/.env.local with your real credentials.
# ==============================================================================

# --- Backend FastAPI Security & Server ---
APP_ENV=production
ENABLE_DEV_SEED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
JWT_SECRET_KEY=replace-with-a-strong-64-char-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- MongoDB Atlas ---
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# If left empty, the backend uses a transparent local disk-persisted Mongo-compatible store
# (reported in /api/health as db_mode="local_disk_fallback") so you can test locally before connecting Atlas.
MONGODB_URI=
MONGODB_DB_NAME=surplusconnect_ai

# --- Google Gemini API (Official google-genai SDK + LangGraph) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Google Maps Platform (Routes API + Geocoding API + Maps JS SDK) ---
# For prototyping without Cloud billing, see https://mapsplatform.google.com/maps-demo-key
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# --- PayPal Developer Sandbox (Orders API v2 & Payouts API v1) ---
# Create Sandbox REST app at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# --- Frontend -> Backend URL ---
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

